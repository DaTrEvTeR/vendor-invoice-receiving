# Configuration for docker compose. `make` copies this file to .env on first use.
# This is a test project: nothing here is a real secret.

# --- Django ---
# Any long random string without '$' (docker compose would treat it as a variable).
# An empty value makes the app generate a throwaway key at start-up.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# 1 = development mode (detailed errors, admin static files served by runserver).
DJANGO_DEBUG=1
# Hosts the backend answers to; "backend" is its name inside the compose network.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (SQLite) ---
# The database is backend/db.sqlite3 (next to manage.py): the same file for docker
# compose (through the ./backend mount) and for a local run. DJANGO_DB_PATH overrides it.
# Seconds a write waits for another write to finish before failing.
DJANGO_DB_TIMEOUT=20

# --- Receiving app ---
# Reference data (catalog, vendors, item map, POs, sample invoices), mounted read-only.
RECEIVING_DATA_DIR=/data
# Where build_outcomes writes outcomes.json.
RECEIVING_RESULTS_DIR=/results
# Largest invoice file accepted, in bytes (1 MiB).
RECEIVING_MAX_UPLOAD_BYTES=1048576

# --- Ports on the host (docker compose) ---
# Change these if 8000 or 3000 is already taken on your machine.
BACKEND_PORT=8000
FRONTEND_PORT=3000
